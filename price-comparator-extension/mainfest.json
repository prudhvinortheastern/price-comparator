{
  "name": "Price Comparator",
  "version": "0.1.0",
  "manifest_version": 3,
  "description": "Shows a warning if cheaper prices are found elsewhere.",
  "permissions": ["storage","tabs"],
  "host_permissions": ["http://localhost:8080/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Price Comparator"
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}